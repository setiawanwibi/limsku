{
  "kode_template": "PNG-ICPMS-02",
  "nama_template": "ICP-MS Cemaran Logam Timbal (Pb) Pangan (31/PA/24)",
  "kategori": "Kimia",
  "komoditi": "pangan",
  "skema_form": {
    "kode_dokumen": "POM-06.02/CFM.01/SOP.01/F.01A.18",
    "judul": "LAMPIRAN CATATAN PENGUJIAN - ICP MS (CEMARAN LOGAM Pb PANGAN)",
    "sections": [
      {
        "id": "kondisi_analisis",
        "title": "A. Kondisi Analisis & Sistem ICP-MS (Pb)",
        "fields": [
          { "id": "alat_merk", "label": "Merk Alat", "type": "text", "default": "Thermo-Scientific", "required": true },
          { "id": "alat_tipe", "label": "Tipe / Seri Alat", "type": "text", "default": "ICAP RQ", "required": true },
          { "id": "detektor", "label": "Detektor", "type": "text", "default": "Quadrapole", "required": true },
          { "id": "mass_analit", "label": "Mass (m/z)", "type": "text", "default": "208", "required": true },
          { "id": "mode_icp", "label": "Mode", "type": "text", "default": "KED" },
          { "id": "gas_mode", "label": "Gas Mode", "type": "radio", "options": ["Tanpa gas", "Gas He", "Gas Argon", "Gas He & Gas Argon"], "default": "Gas He & Gas Argon" },
          { "id": "kondisi_tuning", "label": "Kondisi Tuning (Hasil Terlampir)", "type": "radio", "options": ["Memenuhi syarat", "Tidak memenuhi syarat"], "default": "Memenuhi syarat", "required": true },
          { "id": "pelarut", "label": "Pelarut", "type": "text", "default": "HNO3 65% (5 mL) : Aquadest", "required": true }
        ]
      },
      {
        "id": "baku_dan_lampiran",
        "title": "B. Informasi Baku Pembanding & Standar Internal",
        "fields": [
          { "id": "baku_pembanding", "label": "Baku Pembanding", "type": "text", "default": "Lead Standard Solution", "required": true },
          { "id": "baku_kadar_mgl", "label": "Konsentrasi Baku Induk (mg/L)", "type": "number", "default": "1000", "required": true },
          { "id": "standar_internal", "label": "Standar Internal (Opsional)", "type": "text", "default": "-" },
          { "id": "blanko_baku_cps", "label": "Blanko Baku (CPS)", "type": "number", "default": "0" },
          { "id": "blanko_sampel_cps", "label": "Blanko Sampel (CPS)", "type": "number", "default": "0", "required": true }
        ]
      },
      {
        "id": "tabel_baku_kerja_sec",
        "title": "C. Penyiapan Baku Antara & Deret Baku Kerja (ng/mL)",
        "fields": [
          {
            "id": "tabel_baku_induk_antara",
            "label": "1. Baku Pembanding & Baku Antara I / II",
            "type": "table",
            "columns": [
              { "id": "tahap", "label": "Larutan", "readonly": true },
              { "id": "vol_pipet", "label": "Vol. Pipet (mL)" },
              { "id": "vol_labu", "label": "Vol. Labu (mL)" },
              { "id": "konsentrasi", "label": "Konsentrasi (ng/mL)" }
            ],
            "default_rows": [
              { "tahap": "Baku Pembanding", "vol_pipet": "-", "vol_labu": "-", "konsentrasi": "1000000" },
              { "tahap": "Baku Antara I", "vol_pipet": "0.75", "vol_labu": "15", "konsentrasi": "" },
              { "tahap": "Baku Antara II", "vol_pipet": "0.15", "vol_labu": "15", "konsentrasi": "" }
            ]
          },
          {
            "id": "tabel_baku_kerja",
            "label": "2. Deret Baku Kerja (ng/mL) — Titik 0 + Deret Kurva",
            "type": "table",
            "columns": [
              { "id": "tahap", "label": "Titik Baku" },
              { "id": "vol_pipet", "label": "Vol. Pipet (mL)" },
              { "id": "vol_labu", "label": "Vol. Labu (mL)" },
              { "id": "konsentrasi", "label": "Konsentrasi (ng/mL)" },
              { "id": "intensitas_analit", "label": "Intensitas Analit (CPS)" },
              { "id": "intensitas_internal", "label": "Intensitas SI (CPS)" },
              { "id": "rasio_intensitas", "label": "Rasio Intensitas" }
            ],
            "default_rows": [
              { "tahap": "Baku 1 (Blanko)", "vol_pipet": "0", "vol_labu": "15", "konsentrasi": "0", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 2", "vol_pipet": "0.0075", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 3", "vol_pipet": "0.015", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 4", "vol_pipet": "0.0375", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 5", "vol_pipet": "0.075", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 6", "vol_pipet": "0.15", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" },
              { "tahap": "Baku 7", "vol_pipet": "0.375", "vol_labu": "15", "konsentrasi": "", "intensitas_analit": "", "intensitas_internal": "", "rasio_intensitas": "" }
            ]
          }
        ]
      },
      {
        "id": "tabel_zat_uji_sec",
        "title": "D. Penimbangan & Pengukuran Zat Uji (Duplo) serta Spiked Sample",
        "fields": [
          {
            "id": "tabel_zat_uji",
            "label": "1. Data Zat Uji (Uji-01 & Uji-02)",
            "type": "table",
            "columns": [
              { "id": "replikasi", "label": "Replikasi", "readonly": true },
              { "id": "wadah_zat", "label": "Wadah + Zat (g)" },
              { "id": "wadah_sisa", "label": "Wadah + Sisa (g)" },
              { "id": "bobot_bersih", "label": "Bobot Bersih w (g)" },
              { "id": "vol_labu", "label": "Vol. Pengenceran (mL)" },
              { "id": "konsentrasi_terukur", "label": "Konsentrasi X (µg/mL)" },
              { "id": "intensitas_analit", "label": "Intensitas Analit (CPS)" }
            ],
            "default_rows": [
              { "replikasi": "1. Uji-01", "wadah_zat": "", "wadah_sisa": "", "bobot_bersih": "", "vol_labu": "50", "konsentrasi_terukur": "", "intensitas_analit": "" },
              { "replikasi": "2. Uji-02", "wadah_zat": "", "wadah_sisa": "", "bobot_bersih": "", "vol_labu": "50", "konsentrasi_terukur": "", "intensitas_analit": "" }
            ]
          },
          {
            "id": "tabel_spiked_sample",
            "label": "2. Data Spiked Sample (SP-01 & SP-02) — Opsional",
            "type": "table",
            "columns": [
              { "id": "replikasi", "label": "Replikasi", "readonly": true },
              { "id": "wadah_zat", "label": "Wadah + Zat (g)" },
              { "id": "wadah_sisa", "label": "Wadah + Sisa (g)" },
              { "id": "bobot_bersih", "label": "Bobot Bersih w (g)" },
              { "id": "vol_labu", "label": "Vol. Pengenceran (mL)" },
              { "id": "konsentrasi_terukur", "label": "Konsentrasi X (µg/mL)" },
              { "id": "intensitas_analit", "label": "Intensitas Analit (CPS)" }
            ],
            "default_rows": [
              { "replikasi": "1. SP-01", "wadah_zat": "", "wadah_sisa": "", "bobot_bersih": "", "vol_labu": "50", "konsentrasi_terukur": "", "intensitas_analit": "" },
              { "replikasi": "2. SP-02", "wadah_zat": "", "wadah_sisa": "", "bobot_bersih": "", "vol_labu": "50", "konsentrasi_terukur": "", "intensitas_analit": "" }
            ]
          }
        ]
      },
      {
        "id": "regresi_kurva_baku",
        "title": "E. Regresi Linear & Perhitungan LOD / LOQ Kurva Baku",
        "fields": [
          { "id": "persamaan_regresi", "label": "Persamaan Regresi Linear (y = bx + a)", "type": "text", "readonly": true },
          { "id": "slope", "label": "Slope (b)", "type": "number", "readonly": true },
          { "id": "intercept", "label": "Intercept (a)", "type": "number", "readonly": true },
          { "id": "koefisien_korelasi", "label": "Koefisien Korelasi (r) — Syarat r >= 0.99000", "type": "number", "readonly": true },
          { "id": "sy_x", "label": "SD Residual (Sy/x)", "type": "number", "readonly": true },
          { "id": "vx0", "label": "Vx0 (Syarat <= 0.05)", "type": "number", "readonly": true },
          { "id": "lod_nilai", "label": "LOD Terhitung", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "loq_nilai", "label": "LOQ Terhitung", "type": "number", "unit": "mg/kg", "readonly": true }
        ]
      },
      {
        "id": "perhitungan_kadar_icpms",
        "title": "F. Perhitungan Kadar Cemaran Logam, RPD & Recovery Spike",
        "fields": [
          { "id": "kadar_replikasi_1", "label": "Kadar Uji-01", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "kadar_replikasi_2", "label": "Kadar Uji-02", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "kadar_rata_mg", "label": "Rata-rata Kadar Cemaran Logam", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "spike_vol_baku_ml", "label": "Volume Baku Antara I Ditambahkan (Opsional)", "type": "number", "unit": "mL", "default": "0.03" },
          { "id": "spike_bobot_sampel_g", "label": "Bobot Sampel Acuan Spike (g)", "type": "number", "unit": "g", "default": "0.3" },
          { "id": "spike_kadar_ditambahkan", "label": "Kadar Baku Ditambahkan", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "spike_kadar_tanpa_spike", "label": "Kadar Sampel Tanpa Spike", "type": "number", "unit": "mg/kg", "default": "0" },
          { "id": "kadar_sp_1", "label": "Kadar SP-01", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "kadar_sp_2", "label": "Kadar SP-02", "type": "number", "unit": "mg/kg", "readonly": true },
          { "id": "recovery_1", "label": "Recovery-01 (Syarat 60 - 115 %)", "type": "number", "unit": "%", "readonly": true },
          { "id": "recovery_2", "label": "Recovery-02 (Syarat 60 - 115 %)", "type": "number", "unit": "%", "readonly": true },
          { "id": "recovery_rata", "label": "Rata-rata Recovery", "type": "number", "unit": "%", "readonly": true },
          { "id": "rpd", "label": "RPD / RSD*", "type": "number", "unit": "%", "readonly": true },
          { "id": "syarat_horwitz", "label": "Syarat 1/2 CV Horwitz", "type": "number", "unit": "%", "readonly": true }
        ]
      },
      {
        "id": "hasil_kesimpulan",
        "title": "G. Pustaka, Syarat & Kesimpulan",
        "fields": [
          { "id": "hasil_uji_kadar_akhir", "label": "Hasil Uji ± Ketidakpastian + Simple Acceptance/Guard Band*", "type": "text", "placeholder": "Contoh: Tidak terdeteksi (< LOD) / 0.05 mg/kg" },
          { "id": "pustaka_metode", "label": "Pustaka Metode", "type": "text", "default": "101/PA/MA-PPPOMN/21" },
          { "id": "pustaka_persyaratan", "label": "Pustaka Persyaratan", "type": "text", "default": "PBPOM No. 9 Tahun 2022" },
          { "id": "syarat", "label": "Syarat (Tolerance Limit / Acceptance Limit)", "type": "textarea", "default": "Tolerance Limit : Maks. 1 mg/kg" },
          { "id": "kesimpulan", "label": "Kesimpulan", "type": "select", "options": ["MS", "TMS", "Tidak Ditentukan"], "required": true }
        ]
      }
    ]
  }
}
