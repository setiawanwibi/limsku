{
  "kode_dokumen": "POM-06.02/CFM.01/SOP.01/F.01A.08",
  "judul": "LAMPIRAN CATATAN PENGUJIAN - DISOLUSI",
  "kategori": "Kimia",
  "sections": [
    {
      "id": "info_alat_disolusi",
      "title": "Data Dissolution Tester & Media Pengujian",
      "description": "Formulir resmi POM-06.02/CFM.01/SOP.01/F.01A.08. Catatan pengujian disolusi sediaan tablet / kapsul.",
      "fields": [
        {
          "id": "nama_instrumen_disolusi",
          "label": "Nama Alat Dissolution Tester",
          "type": "text",
          "placeholder": "Dissolution Tester Hanson / Erweka / Distek"
        },
        {
          "id": "kode_alat_disolusi",
          "label": "Kode Alat",
          "type": "text",
          "placeholder": "Contoh: LAB-DT-01"
        },
        {
          "id": "tipe_alat_disolusi",
          "label": "Tipe Alat Disolusi (Metode FI)",
          "type": "select",
          "options": [
            "Tipe 1 (Keranjang / Basket)",
            "Tipe 2 (Dayung / Paddle)",
            "Tipe 3 (Silinder Bolak-Balik)",
            "Tipe 4 (Sel Mengalir)"
          ],
          "default": "Tipe 2 (Dayung / Paddle)"
        },
        {
          "id": "media_disolusi",
          "label": "Media Disolusi",
          "type": "text",
          "placeholder": "Contoh: HCl 0.1 N / Dapar Fosfat pH 5.8 / Dapar Fosfat pH 6.8 / Air Murni"
        },
        {
          "id": "volume_media",
          "label": "Volume Media Disolusi (mL) (P12)",
          "type": "number",
          "step": "any",
          "placeholder": "Contoh: 900",
          "keterangan": "Parameter V dalam rumus Fk"
        },
        {
          "id": "kecepatan_rpm",
          "label": "Kecepatan Putaran (rpm)",
          "type": "number",
          "placeholder": "Contoh: 50 atau 100"
        },
        {
          "id": "waktu_menit",
          "label": "Waktu Pengujian (menit)",
          "type": "number",
          "placeholder": "Contoh: 30 atau 45"
        },
        {
          "id": "suhu_media",
          "label": "Suhu Media (°C)",
          "type": "number",
          "step": "0.1",
          "default": "37.0",
          "placeholder": "37 ± 0.5"
        },
        {
          "id": "suhu_ruang",
          "label": "Suhu Ruang (°C)",
          "type": "number",
          "step": "0.1",
          "placeholder": "20.0 - 25.0"
        },
        {
          "id": "kelembaban_rh",
          "label": "Kelembaban Ruang (% RH)",
          "type": "number",
          "step": "0.1",
          "placeholder": "40.0 - 60.0"
        },
        {
          "id": "komposisi_etiket",
          "label": "Kandungan Zat Aktif Pada Etiket (mg) (D10 / Ke)",
          "type": "number",
          "step": "any",
          "placeholder": "Contoh: 500",
          "keterangan": "Parameter Ke (Klaim etiket per tablet/kapsul dalam mg) dalam rumus Fk"
        },
        {
          "id": "toleransi_q",
          "label": "Toleransi Q Monografi (%)",
          "type": "number",
          "step": "any",
          "default": "80",
          "placeholder": "Contoh: 75, 80, 85",
          "keterangan": "Nilai Q standar monografi FI/ekstra (digunakan untuk evaluasi kelulusan S1/S2/S3)"
        },
        {
          "id": "catatan_kondisi_alat",
          "label": "Catatan Kondisi Alat & Media",
          "type": "textarea",
          "rows": 2,
          "placeholder": "Kondisi fisik bejana, dayung, visual larutan selama disolusi..."
        }
      ]
    },
    {
      "id": "info_baku_dan_analisis",
      "title": "Instrumen Deteksi & Preparasi Baku Pembanding",
      "description": "Pengukuran baku pembanding dan faktor pengenceran untuk rumus perhitungan faktor pengali Fk.",
      "fields": [
        {
          "id": "metode_analisis_filtrat",
          "label": "Metode Analisis Filtrat",
          "type": "select",
          "options": [
            "Spektrofotometri UV-Vis",
            "Kromatografi Cair Kinerja Tinggi (KCKT / HPLC)",
            "Titrasi",
            "Lainnya"
          ],
          "default": "Spektrofotometri UV-Vis"
        },
        {
          "id": "nama_alat_ukur",
          "label": "Nama Alat Ukur",
          "type": "text",
          "placeholder": "Spektrofotometer UV-Vis Shimadzu UV-1800 / KCKT Waters"
        },
        {
          "id": "panjang_gelombang_nm",
          "label": "Panjang Gelombang Pengukuran (nm)",
          "type": "number",
          "step": "any",
          "placeholder": "Contoh: 243.0"
        },
        {
          "id": "nama_baku_pembanding",
          "label": "Nama Baku Pembanding (BPFI / CRS)",
          "type": "text",
          "placeholder": "Parasetamol BPFI / Asetaminofen BPFI"
        },
        {
          "id": "nomor_lot_baku",
          "label": "Nomor Lot / Batch Baku Pembanding",
          "type": "text",
          "placeholder": "Contoh: LOT-BPFI-2024-001"
        },
        {
          "id": "kadar_baku",
          "label": "Kemurnian / Kadar Baku Pembanding (P18) (%)",
          "type": "number",
          "step": "any",
          "default": "100.0",
          "placeholder": "Contoh: 99.8",
          "keterangan": "Parameter Kb mentah (sebelum koreksi susut pengeringan)"
        },
        {
          "id": "susut_pengeringan",
          "label": "Susut Pengeringan Baku (P19) (%)",
          "type": "number",
          "step": "any",
          "default": "0",
          "placeholder": "Contoh: 0.15",
          "keterangan": "Koreksi kemurnian: Kb_terkoreksi = (100 - SP) * (rawKb / 100)"
        },
        {
          "id": "kadar_baku_terkoreksi",
          "label": "Kadar Terkoreksi Baku Pembanding (Kb Terkoreksi) (%)",
          "type": "number",
          "step": "any",
          "readonly": true,
          "placeholder": "=(100 - Susut Pengeringan) * (Kadar Baku / 100)",
          "keterangan": "Dihitung otomatis: (100 - Susut Pengeringan) * (Kadar Baku / 100)"
        },
        {
          "id": "bobot_baku_mg",
          "label": "Bobot Baku Pembanding Ditimbang (mg) (P21)",
          "type": "number",
          "step": "any",
          "placeholder": "Contoh: 50.2",
          "keterangan": "Parameter Bb dalam rumus Fk"
        },
        {
          "id": "faktor_konversi_bm",
          "label": "Faktor Konversi BM (BM1 / BM2)",
          "type": "text",
          "default": "1.0",
          "placeholder": "Contoh: 1.0 atau rumus pecahan: 328.84/365.30",
          "keterangan": "Bisa berupa desimal (1.0) atau ekspresi pembagian bobot molekul (misal BM1/BM2)"
        },
        {
          "id": "hasil_ukur_baku_ab",
          "label": "Hasil Pengukuran Larutan Baku (Ab / Area Baku) (P24)",
          "type": "number",
          "step": "any",
          "placeholder": "Contoh: 0.452",
          "keterangan": "Parameter Ab dalam penyebut rumus Fk"
        },
        {
          "id": "faktor_pengenceran_baku",
          "label": "Faktor Pengenceran Baku (Fb) (P25)",
          "type": "number",
          "step": "any",
          "default": "1",
          "placeholder": "Contoh: 5000 (Labu 100 mL -> pipet 2 mL -> ad 100 mL)",
          "keterangan": "Parameter Fb dalam penyebut rumus Fk (Contoh: 100 * 100 / 2 = 5000)"
        },
        {
          "id": "faktor_pengenceran_uji",
          "label": "Faktor Pengenceran Filtrat Uji (Fu) (P26)",
          "type": "number",
          "step": "any",
          "default": "1",
          "placeholder": "Contoh: 10 (Pipet 5 mL filtrat ad 50 mL)",
          "keterangan": "Parameter Fu dalam pembilang rumus Fk (Jika langsung diukur tanpa pengenceran, isi 1)"
        }
      ]
    },
    {
      "id": "data_tahap_s1",
      "title": "Pengamatan & Hasil Tahap S1 (6 Unit)",
      "description": "Pengukuran serapan/area 6 bejana disolusi Tahap S1. % Terlarut dihitung otomatis sesuai Fk.",
      "fields": [
        {
          "id": "faktor_perkalian_fk",
          "label": "Faktor Perkalian (Fk Otomatis)",
          "type": "number",
          "step": "any",
          "placeholder": "=(V * Fu * Bb * Kb * BMkoreksi * 100) / (Fb * Ab * Ke)",
          "keterangan": "Dihitung otomatis dari parameter media, baku, pengenceran, dan etiket."
        },
        {
          "id": "faktor_pengali_tambahan",
          "label": "Faktor Pengali Tambahan (Opsional Manual)",
          "type": "text",
          "default": "1.0",
          "placeholder": "Contoh: 1.0 atau 2 atau 50/10",
          "keterangan": "Opsional: Pengali manual jika ada perkalian/pengenceran tambahan (bisa pecahan misal 50/10). Default: 1.0"
        },
        {
          "id": "faktor_perkalian_final",
          "label": "Faktor Perkalian Final (Fk Final)",
          "type": "number",
          "step": "any",
          "placeholder": "= Fk Otomatis * Faktor Pengali Tambahan",
          "keterangan": "Faktor perkalian akhir yang digunakan untuk menghitung % zat aktif terlarut (Dx)."
        },
        {
          "id": "tabel_s1",
          "label": "Tabel Hasil Disolusi Tahap S1 (6 Bejana)",
          "type": "table",
          "columns": [
            {
              "id": "bejana_no",
              "label": "Bejana",
              "readonly": true
            },
            {
              "id": "pengukuran_au",
              "label": "Pengukuran (Au / Area)"
            },
            {
              "id": "persen_terlarut",
              "label": "% Zat Aktif Terlarut (Dx)"
            }
          ],
          "default_rows": [
            {
              "bejana_no": "1",
              "pengukuran_au": "",
              "persen_terlarut": ""
