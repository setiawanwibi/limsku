              "persen_terlarut": ""
            }
          ]
        },
        {
          "id": "rata_rata_s1",
          "label": "Rata-rata % Terlarut Tahap S1 (N63)",
          "type": "number",
          "step": "any",
          "placeholder": "=AVERAGE(Unit 1 - 6)"
        },
        {
          "id": "nilai_minimum_s1",
          "label": "Nilai Terendah % Terlarut S1 (G74)",
          "type": "number",
          "step": "any",
          "placeholder": "=MIN(Unit 1 - 6)"
        }
      ]
    },
